model
  schema 1.1

# Een gebruiker, zoals Keycloak hem kent: user:<sub>
type user

# Een bericht: message:<id>
# De API schrijft bij elk nieuw bericht twee feiten (tuples) weg:
#   user:<sub van de afzender>  sender     message:<id>
#   user:<sub van de ontvanger> recipient  message:<id>
# Wie wat mag, staat enkel hieronder. De API vraagt het alleen nog maar.
type message
  relations
    define sender: [user]
    define recipient: [user]
    define can_read: recipient
    define can_delete: sender
